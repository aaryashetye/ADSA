import java.util.Scanner;

class Node {
    int data;
    Node left, right;

    Node(int data) {
        this.data = data;
    }
}

public class BinaryTreeTraversals {
    public static Node createTree(Scanner sc) {
        System.out.print("Enter node value (-1 for NULL): ");
        int val = sc.nextInt();
        if (val == -1) return null;

        Node root = new Node(val);
        System.out.println("Enter left child of " + val);
        root.left = createTree(sc);
        System.out.println("Enter right child of " + val);
        root.right = createTree(sc);

        return root;
    }

    public static void preOrder(Node root) {
        if (root == null) return;
        System.out.print(root.data + " ");
        preOrder(root.left);
        preOrder(root.right);
    }

    public static void inOrder(Node root) {
        if (root == null) return;
        inOrder(root.left);
        System.out.print(root.data + " ");
        inOrder(root.right);
    }

    public static void postOrder(Node root) {
        if (root == null) return;
        postOrder(root.left);
        postOrder(root.right);
        System.out.print(root.data + " ");
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("--- Binary Tree Construction ---");
        Node root = createTree(sc);

        System.out.print("\nPre-order Traversal:  ");
        preOrder(root);
        System.out.print("\nIn-order Traversal:   ");
        inOrder(root);
        System.out.print("\nPost-order Traversal: ");
        postOrder(root);
        System.out.println();
    }
}
